# Copy to .env (or set these in your host's dashboard). Nothing here is required to try the app locally.

# Password for the admin screens (username can be anything). Required before the app is reachable from the internet.
ADMIN_PASSWORD=

# outbox = save emails to data/outbox and send nothing (default).
# microsoft = really send through Microsoft 365. smtp = really send through an SMTP server.
SEND_MODE=outbox

# Microsoft 365 (Office 365) mailbox, via an Entra ID app registration with the
# Mail.Send application permission. Invoices are sent as the accounts email set in Settings.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Any other mail provider's outgoing server. Only used when SEND_MODE=smtp.
# Google Workspace: smtp.gmail.com, port 465, SMTP_SECURE=true, an app password.
# (Microsoft 365 no longer accepts passwords over SMTP: use the MS_ settings above.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Hour of the day (business timezone, set in Settings) when daily reminders go out.
REMINDER_HOUR=9

# Where Chromium lives, for PDF invoices. The Docker image sets this for you.
CHROMIUM_PATH=

PORT=3000

# GUID from the Australian Business Register (ABN Lookup web services). Turns on the
# "Find on the ABR" search when adding a client. Keep it out of the code; set it in Railway Variables.
ABR_GUID=
